<!-- How ClickHouse reaches the lake. The gold bucket is read with the read-only
     analyst account (see platform/minio/policies/analyst.json); the keys come from
     the container environment, so they never appear in SQL or in query logs. -->
<clickhouse>
    <named_collections>
        <gold_lake>
            <url>http://minio:9000/fraudlens-gold/</url>
            <access_key_id from_env="ANALYST_ACCESS_KEY"/>
            <secret_access_key from_env="ANALYST_SECRET_KEY"/>
        </gold_lake>
    </named_collections>
    <!-- keep caches small: the platform runs on a 16 GB laptop -->
    <mark_cache_size>268435456</mark_cache_size>
</clickhouse>
