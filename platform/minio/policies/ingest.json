{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "NiFiLandsRawFilesOnly", "Effect": "Allow",
     "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
     "Resource": ["arn:aws:s3:::fraudlens-raw/sparkov/*"]},
    {"Sid": "NiFiListsRaw", "Effect": "Allow",
     "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
     "Resource": ["arn:aws:s3:::fraudlens-raw"]}
  ]
}
