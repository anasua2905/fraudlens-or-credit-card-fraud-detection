{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "PipelineReadWriteLake", "Effect": "Allow",
     "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation",
                "s3:ListBucketMultipartUploads", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
     "Resource": ["arn:aws:s3:::fraudlens-raw", "arn:aws:s3:::fraudlens-raw/*",
                  "arn:aws:s3:::fraudlens-silver", "arn:aws:s3:::fraudlens-silver/*",
                  "arn:aws:s3:::fraudlens-gold", "arn:aws:s3:::fraudlens-gold/*"]},
    {"Sid": "PipelineListBuckets", "Effect": "Allow", "Action": ["s3:ListAllMyBuckets", "s3:CreateBucket"],
     "Resource": ["arn:aws:s3:::*"]}
  ]
}
