{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "AnalystsReadGoldOnly", "Effect": "Allow",
     "Action": ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
     "Resource": ["arn:aws:s3:::fraudlens-gold", "arn:aws:s3:::fraudlens-gold/*"]},
    {"Sid": "NoRawOrSilver", "Effect": "Deny", "Action": ["s3:*"],
     "Resource": ["arn:aws:s3:::fraudlens-raw", "arn:aws:s3:::fraudlens-raw/*",
                  "arn:aws:s3:::fraudlens-silver", "arn:aws:s3:::fraudlens-silver/*"]}
  ]
}
