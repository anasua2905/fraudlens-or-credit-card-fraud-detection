# One Python image for the platform's Python services: the scoring API (FastAPI),
# the MLflow tracking server, and the MinIO and NiFi initialisation jobs.
# Library versions are constrained by requirements.lock.txt: the exact versions that
# trained the submitted model, so a pickled model loads with the same libraries.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MLFLOW_DISABLE_AGENT_HINT=1
COPY pyproject.toml README.md ./
COPY requirements.lock.txt ./constraints.txt
COPY src ./src
RUN pip install -c constraints.txt -e ".[ml,serve,platform]"
COPY config ./config
COPY platform/minio ./platform/minio
COPY platform/nifi ./platform/nifi
EXPOSE 8000 5000
CMD ["uvicorn", "fraudlens.api:app", "--host", "0.0.0.0", "--port", "8000"]
