{
  "catalogs": [
    {"user": "(pipeline|admin)", "allow": "all"},
    {"user": "(analyst|superset)", "catalog": "(hive|system)", "allow": "read-only"},
    {"allow": "none"}
  ],
  "schemas": [
    {"user": "(pipeline|admin)", "owner": true},
    {"user": "(analyst|superset)", "owner": false}
  ],
  "tables": [
    {"user": "(pipeline|admin)", "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP"]},

    {"user": "superset", "catalog": "hive", "schema": "gold", "privileges": ["SELECT"],
     "columns": [{"name": "card_id", "mask": "concat(substr(card_id, 1, 4), '************')"}]},
    {"user": "superset", "catalog": "hive", "schema": "(raw|silver)", "privileges": []},

    {"user": "analyst", "catalog": "hive", "schema": "silver", "table": "transactions", "privileges": ["SELECT"],
     "columns": [
       {"name": "dob", "mask": "date_trunc('year', dob)"},
       {"name": "zip", "mask": "(zip / 100) * 100"},
       {"name": "lat", "mask": "round(lat, 1)"},
       {"name": "lon", "mask": "round(lon, 1)"},
       {"name": "job", "allow": false}
     ]},
    {"user": "analyst", "catalog": "hive", "schema": "gold", "privileges": ["SELECT"]},
    {"user": "analyst", "catalog": "hive", "schema": "raw", "privileges": []},

    {"catalog": "system", "privileges": ["SELECT"]}
  ]
}
