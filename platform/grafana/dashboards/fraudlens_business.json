  {
   "id": 5,
   "type": "timeseries",
   "title": "Fraud caught vs missed per day",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "queryType": "timeseries",
     "rawSql": "SELECT toStartOfDay(ts) AS time, countIf(outcome = 'caught') AS caught, countIf(outcome = 'missed') AS missed, countIf(outcome = 'false_alert') AS false_alerts FROM fraudlens.scored_transactions WHERE $__timeFilter(ts) GROUP BY time ORDER BY time"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "caught"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#1baf7a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "missed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e34948"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "false_alerts"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#eda100"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "barchart",
   "title": "Fraud rate by merchant category (%)",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT category, round(100 * avg(is_fraud), 3) AS fraud_rate_pct FROM fraudlens.scored_transactions GROUP BY category ORDER BY fraud_rate_pct DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "fixed",
      "fixedColor": "#eb6834"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "xField": "category",
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "Merchants with the most missed fraud value",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT merchant, count() AS missed, round(sum(amount), 2) AS missed_amount FROM fraudlens.scored_transactions WHERE outcome = 'missed' GROUP BY merchant ORDER BY missed_amount DESC LIMIT 15"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
