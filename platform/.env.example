# Copy to platform/.env and change every password before starting the platform.
# These are LOCAL development credentials; never commit platform/.env.

# MinIO root (administrator) account
MINIO_ROOT_USER=fraudlens-admin
MINIO_ROOT_PASSWORD=change-me-minio-root

# Service accounts created by minio-init (least privilege, see minio/policies/)
PIPELINE_ACCESS_KEY=fraudlens-pipeline
PIPELINE_SECRET_KEY=change-me-pipeline
TRINO_S3_ACCESS_KEY=fraudlens-trino
TRINO_S3_SECRET_KEY=change-me-trino
ANALYST_ACCESS_KEY=fraudlens-analyst
ANALYST_SECRET_KEY=change-me-analyst
INGEST_ACCESS_KEY=fraudlens-ingest
INGEST_SECRET_KEY=change-me-ingest

# Apache NiFi single-user login (password: at least 12 characters)
NIFI_USERNAME=fraudlens
NIFI_PASSWORD=change-me-nifi-password

# ClickHouse analytics user `fraudlens`
CLICKHOUSE_PASSWORD=change-me-clickhouse

# Hive Metastore database
POSTGRES_PASSWORD=change-me-postgres

# Superset and Grafana web logins (user: admin)
SUPERSET_SECRET_KEY=replace-with-a-long-random-string
SUPERSET_ADMIN_PASSWORD=change-me-superset
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# The host-side pipeline reads these (see config/pipeline.yaml -> platform)
FRAUDLENS_S3_ENDPOINT=http://localhost:9000
FRAUDLENS_S3_ACCESS_KEY=fraudlens-pipeline
FRAUDLENS_S3_SECRET_KEY=change-me-pipeline
FRAUDLENS_TRINO_HOST=localhost
FRAUDLENS_TRINO_PORT=8080
FRAUDLENS_TRINO_USER=pipeline
FRAUDLENS_CLICKHOUSE_URL=http://localhost:8123
FRAUDLENS_CLICKHOUSE_PASSWORD=change-me-clickhouse
# FRAUDLENS_INGEST=nifi      # land raw files through NiFi instead of a direct upload
# MLFLOW_TRACKING_URI=http://localhost:5000
